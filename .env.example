# Development PostgreSQL database (created by docker-compose.yml)
DATABASE_URL="postgresql://sysfortech:sysfortech_local_pw@localhost:5432/sysfortech_dev?schema=public"

# Default fallback demo identity when no header/cookie is supplied in local dev
DEFAULT_DEMO_USER="client-northstar"

# Enable GraphiQL interactive explorer in local development
NEXT_PUBLIC_APP_NAME="Sysfortech Client Portal"
